#!/bin/sh
# Disclosure check on exactly what is staged. Installed by
#   git config core.hooksPath .githooks
# (Claude Code sessions in this repository set that up automatically.)
command -v node >/dev/null 2>&1 || { echo "pre-commit: Node.js not found, so the disclosure check can't run. Install Node 18+." >&2; exit 1; }
exec node "$(git rev-parse --show-toplevel)/tools/disclosure-check.mjs" --staged
